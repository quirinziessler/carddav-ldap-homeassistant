#!/usr/bin/with-contenv bashio

bashio::log.info "Konfiguriere CardDAV Sync..."

if [ -f /data/options.json ]; then
    CRON_SCHEDULE=$(jq -r '.sync_interval_cron // "0 * * * *"' /data/options.json)
else
    CRON_SCHEDULE="0 * * * *"
fi

echo "$CRON_SCHEDULE python3 /app/sync.py > /proc/1/fd/1 2>&1" > /etc/crontabs/root

bashio::log.info "Warte 5 Sekunden bis LDAP hochgefahren ist..."
sleep 5

bashio::log.info "Führe initialen Sync aus..."
python3 /app/sync.py

bashio::log.info "Starte Cron-Daemon für fortlaufenden Sync (${CRON_SCHEDULE})..."
exec crond -f -l 2
