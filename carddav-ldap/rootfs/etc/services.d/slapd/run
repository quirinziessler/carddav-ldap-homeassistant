#!/usr/bin/with-contenv bashio

mkdir -p /run/openldap
mkdir -p /var/lib/openldap/openldap-data
chown -R ldap:ldap /var/lib/openldap/openldap-data /run/openldap

LDAP_USER=""
LDAP_PASS=""

if [ -f /data/options.json ]; then
    LDAP_USER=$(jq -r '.ldap_user // ""' /data/options.json)
    LDAP_PASS=$(jq -r '.ldap_pass // ""' /data/options.json)
fi

SLAPD_CONF="/etc/openldap/slapd.conf"

if [ -n "${LDAP_USER}" ] && [ -n "${LDAP_PASS}" ] && [ "${LDAP_USER}" != "null" ] && [ "${LDAP_PASS}" != "null" ]; then
    bashio::log.info "LDAP-Authentifizierung AKTIVIERT: Benutzer '${LDAP_USER}' mit Passwort konfiguriert."
    BIND_DN="cn=${LDAP_USER},dc=home,dc=local"

    cat <<EOF > "${SLAPD_CONF}"
include /etc/openldap/schema/core.schema
include /etc/openldap/schema/cosine.schema
include /etc/openldap/schema/inetorgperson.schema

pidfile /run/openldap/slapd.pid
argsfile /run/openldap/slapd.args

modulepath /usr/lib/openldap
moduleload back_mdb.so

database mdb
maxsize 1073741824
suffix "dc=home,dc=local"
rootdn "${BIND_DN}"
rootpw "${LDAP_PASS}"
directory /var/lib/openldap/openldap-data

index objectClass eq
index cn,sn,givenName eq,sub
index telephoneNumber,homePhone,mobile eq,sub

# Verbiete anonyme Bind-Anfragen
disallow bind_anon

# Zugriff nur fuer authentifizierten Benutzer
access to *
    by dn="${BIND_DN}" write
    by * none
EOF

else
    bashio::log.info "LDAP-Authentifizierung DEAKTIVIERT (Anonymer Zugriff erlaubt, kein Benutzername/Passwort erforderlich)."

    cat <<EOF > "${SLAPD_CONF}"
include /etc/openldap/schema/core.schema
include /etc/openldap/schema/cosine.schema
include /etc/openldap/schema/inetorgperson.schema

pidfile /run/openldap/slapd.pid
argsfile /run/openldap/slapd.args

modulepath /usr/lib/openldap
moduleload back_mdb.so

database mdb
maxsize 1073741824
suffix "dc=home,dc=local"
rootdn "cn=admin,dc=home,dc=local"
rootpw "admin_internal"
directory /var/lib/openldap/openldap-data

index objectClass eq
index cn,sn,givenName eq,sub
index telephoneNumber,homePhone,mobile eq,sub

# Erlaube anonymen Lesezugriff
access to *
    by dn="cn=admin,dc=home,dc=local" write
    by * read
EOF
fi

bashio::log.info "Starte OpenLDAP (slapd)..."
exec slapd -d 1 -u ldap -g ldap -f "${SLAPD_CONF}"
